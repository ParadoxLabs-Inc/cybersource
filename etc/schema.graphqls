type Query {
    cyberSourceUnifiedCheckoutCaptureContext(input: TokenBaseCyberSourceUnifiedCheckoutInput!): TokenBaseCyberSourceUnifiedCheckoutCaptureContext @resolver(class: "ParadoxLabs\\CyberSource\\Model\\Api\\GraphQL\\UnifiedCheckout\\CaptureContext") @doc(description: "Get a CyberSource Unified Checkout capture-context JWT for collecting payment data.")
}

input TokenBaseCyberSourceUnifiedCheckoutInput {
    cartId: String
    guestEmail: String
    billingAddress: CustomerAddressInput
}

type TokenBaseCyberSourceUnifiedCheckoutCaptureContext {
    captureContext: String
}

type TokenBaseCheckoutConfig {
    fingerprintUrl: String
}

input TokenBaseCardPaymentInput {
    transient_token: String @doc(description: "CyberSource Unified Checkout transient-token JWT for a newly entered card. Provide exactly one of transient_token or card_id.")
}
